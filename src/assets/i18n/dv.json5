  "submission.sections.sherpa.publication.information": "ޕަބްލިކޭޝަން މައުލޫމާތު",

  "submission.sections.sherpa.publication.information.title": "ސުރުހީ",

  "submission.sections.sherpa.publication.information.issns": "ISSN ތައް",

  "submission.sections.sherpa.publication.information.url": "URL",

  "submission.sections.sherpa.publication.information.publishers": "ޕަބްލިޝަރު",

  "submission.sections.sherpa.publication.information.romeoPub": "Romeo Pub",

  "submission.sections.sherpa.publication.information.zetoPub": "Zeto Pub",

  "submission.sections.sherpa.publisher.policy": "ޕަބްލިޝަރުގެ ޕޮލިސީ",

  "submission.sections.sherpa.publisher.policy.description": "ތިރީގައިވާ މައުލޫމާތުތައް ނަގާފައިވަނީ Sherpa Romeo އިންނެވެ. ތިޔަ ފަރާތުގެ ޕަބްލިޝަރުގެ ޕޮލިސީތަކަށް ބަލާއިރު، މިއީ އެމްބާގޯއެއް ބޭނުންވޭތޯ ނުވަތަ އަޕްލޯޑް ކުރެވޭނީ ކޮން ފައިލްތަކެއްތޯ ބަލާލުމަށް އެހީތެރިވެދޭނެ މައުލޫމާތެކެވެ. އެއްވެސް ސުވާލެއް އޮތްނަމަ، ފުޓަރގައިވާ ފީޑްބެކް ފޯމް މެދުވެރިކޮށް އެޑްމިނިސްޓްރޭޓަރާ ގުޅުއްވާ.",

  "submission.sections.sherpa.publisher.policy.openaccess": "މި ޖާނަލްގެ ޕޮލިސީގެ ދަށުން ހުއްދަ ދީފައިވާ އޯޕަން އެކްސެސް މަގުތައް ތިރީގައި އެވަނީއެވެ. އިތުރު ތަފްސީލު ބަލާލުމަށް ކޮންމެ މަގަކަށް ފިތާލާށެވެ.",

  "submission.sections.sherpa.publisher.policy.more.information": "އިތުރު މައުލޫމާތު ހޯއްދެވުމަށް ތިރީގައިވާ ލިންކުތައް ބައްލަވާލައްވާ:",

  "submission.sections.sherpa.publisher.policy.version": "ވާޝަން",

