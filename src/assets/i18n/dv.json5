  "ldn-new-service.form.placeholder.score": "0 އާއި 1 އާ ދެމެދުގެ އަދަދެއް ލިޔުއްވާ. ދިހައިގެ ބައި ވަކިކުރުމަށް \".\" ބޭނުންކުރައްވާ",

  "ldn-service.form.label.placeholder.default-select": "ޕެޓާނެއް ހިޔާރުކުރޭ",

  "ldn-service.form.pattern.ack-accept.label": "ބަލައިގަތުން އަދި ގަބޫލުކުރުން (Acknowledge and Accept)",

  "ldn-service.form.pattern.ack-accept.description": "މި ޕެޓާން ބޭނުންކުރެވެނީ ހުށަހެޅުމެއް ބަލައިގަނެ އެއާ މެދު އަމަލުކުރުމުގެ ނިޔަތް ހާމަކުރުމަށެވެ.",

  "ldn-service.form.pattern.ack-accept.category": "ބަލައިގަތުންތައް (Acknowledgements)",

  "ldn-service.form.pattern.ack-reject.label": "ބަލައިގަތުން އަދި ރިޖެކްޓްކުރުން (Acknowledge and Reject)",

  "ldn-service.form.pattern.ack-reject.description": "މި ޕެޓާން ބޭނުންކުރެވެނީ ހުށަހެޅުމެއް ބަލައިގަނެ އެއާ މެދު އެއްވެސް އަމަލެއް ނުކުރާނެކަން ހާމަކުރުމަށެވެ.",

  "ldn-service.form.pattern.ack-reject.category": "ބަލައިގަތުންތައް (Acknowledgements)",

  "ldn-service.form.pattern.ack-tentative-accept.label": "ބަލައިގަތުން އަދި ވަގުތީގޮތުން ގަބޫލުކުރުން",

  "ldn-service.form.pattern.ack-tentative-accept.description": "މި ޕެޓާން ބޭނުންކުރެވެނީ ހުށަހެޅުމެއް ބަލައިގަނެ ވަގުތީގޮތުން އެއާ މެދު އަމަލުކުރުމުގެ ނިޔަތް ހާމަކުރުމަށެވެ. މިއީ ފަހުން ބަދަލުވެދާނެ ނިންމުމެކެވެ.",

  "ldn-service.form.pattern.ack-tentative-accept.category": "ބަލައިގަތުންތައް (Acknowledgements)",

  "ldn-service.form.pattern.ack-tentative-reject.label": "ބަލައިގަތުން އަދި ވަގުތީގޮތުން ރިޖެކްޓްކުރުން",

  "ldn-service.form.pattern.ack-tentative-reject.description": "މި ޕެޓާން ބޭނުންކުރެވެނީ ހުށަހެޅުމެއް ބަލައިގަނެ ވަގުތީގޮތުން އެއާ މެދު އަމަލު ނުކުރާނެކަން ހާމަކުރުމަށެވެ. މިއީ ފަހުން ބަދަލުވެދާނެ ނިންމުމެކެވެ.",

  "ldn-service.form.pattern.ack-tentative-reject.category": "ބަލައިގަތުންތައް (Acknowledgements)",

  "ldn-service.form.pattern.announce-endorsement.label": "އެންޑޯސްމަންޓް އިއުލާންކުރުން",

  "ldn-service.form.pattern.announce-endorsement.description": "މި ޕެޓާން ބޭނުންކުރެވެނީ އެންޑޯސްމަންޓެއް އޮތްކަން އިއުލާންކޮށް އެ ވަސީލަތަކަށް އިޝާރާތް ކުރުމަށެވެ.",

  "ldn-service.form.pattern.announce-endorsement.category": "އިއުލާންތައް (Announcements)",

  "ldn-service.form.pattern.announce-ingest.label": "އިންޖެސްޓް އިއުލާންކުރުން",

  "ldn-service.form.pattern.announce-ingest.description": "މި ޕެޓާން ބޭނުންކުރެވެނީ ވަސީލަތެއް ސިސްޓަމަށް ނެގިފައިވާކަން (Ingested) އިއުލާން ކުރުމަށެވެ.",

  "ldn-service.form.pattern.announce-ingest.category": "އިއުލާންތައް (Announcements)",

  "ldn-service.form.pattern.announce-relationship.label": "ގުޅުން އިއުލާންކުރުން",

  "ldn-service.form.pattern.announce-relationship.description": "މި ޕެޓާން ބޭނުންކުރެވެނީ ދެ ވަސީލަތެއްގެ މެދުގައިވާ ގުޅުން އިއުލާން ކުރުމަށެވެ.",

  "ldn-service.form.pattern.announce-relationship.category": "އިއުލާންތައް (Announcements)",

  "ldn-service.form.pattern.announce-review.label": "ރިވިއު އިއުލާންކުރުން",

