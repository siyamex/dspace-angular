  "item.edit.metadata.notifications.discarded.content": "ތިޔަ ގެނައި ބަދަލުތައް އުކާލެވިއްޖެއެވެ. ބަދަލުތައް އަލުން ގެނައުމަށް 'Undo' ފިތަށް ފިއްތާލައްވާ",

  "item.edit.metadata.notifications.discarded.title": "ބަދަލުތައް އުކާލެވިއްޖެ",

  "item.edit.metadata.notifications.error.title": "މައްސަލައެއް ދިމާވެއްޖެއެވެ",

  "item.edit.metadata.notifications.invalid.content": "ތިޔަ ގެނައި ބަދަލުތައް ސޭވްއެއް ނުކުރެވުނެވެ. ސޭވްކުރުމުގެ ކުރިން ހުރިހާ ދާއިރާއެއް ރަނގަޅުތޯ ޔަގީންކުރައްވާ.",

  "item.edit.metadata.notifications.invalid.title": "މެޓަޑޭޓާ ރަނގަޅެއް ނޫން",

  "item.edit.metadata.notifications.outdated.content": "ތިޔަ ބަދަލު ގެންނަ އައިޓަމަށް މިހާރު އެހެން ފަރާތަކުން ވަނީ ބަދަލެއް ގެނޭސްފައެވެ. އެހެންވެ، މައްސަލަ ދިމާވިޔަ ނުދިނުމަށް ތިޔަ ގެނައި ބަދަލުތައް އުކާލެވިއްޖެއެވެ",

