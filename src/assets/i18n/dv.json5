  "submission.submit.breadcrumbs": "އައު ހުށަހެޅުން",

  "submission.submit.title": "އައު ހުށަހެޅުން",

  "submission.workflow.generic.delete": "ފޮހެލާ",

  "submission.workflow.generic.delete-help": "މި އައިޓަމް އުކާލުމަށް މި އޮޕްޝަން ހިޔާރުކުރޭ. ދެން ތިޔަ ފަރާތް ކައިރީގައި އެކަން ކަށަވަރުކުރަން އަހާނެއެވެ.",

