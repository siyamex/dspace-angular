  "itemtemplate.edit.metadata.metadatafield.invalid": "ސައްހަ މެޓަޑޭޓާ ފީލްޑެއް ހިޔާރުކުރައްވާ",

  "itemtemplate.edit.metadata.notifications.discarded.content": "ތިޔަ ގެނައި ބަދަލުތައް އުކާލެވިއްޖެއެވެ. ބަދަލުތައް އަލުން ގެނައުމަށް 'Undo' ފިތަށް ފިއްތާލައްވާ",

  "itemtemplate.edit.metadata.notifications.discarded.title": "ބަދަލުތައް އުކާލެވިއްޖެ",

  "itemtemplate.edit.metadata.notifications.error.title": "މައްސަލައެއް ދިމާވެއްޖެއެވެ",

  "itemtemplate.edit.metadata.notifications.invalid.content": "ތިޔަ ގެނައި ބަދަލުތައް ސޭވްއެއް ނުކުރެވުނެވެ. ސޭވްކުރުމުގެ ކުރިން ހުރިހާ ދާއިރާއެއް ރަނގަޅުތޯ ޔަގީންކުރައްވާ.",

  "itemtemplate.edit.metadata.notifications.invalid.title": "މެޓަޑޭޓާ ރަނގަޅެއް ނޫން",

  "itemtemplate.edit.metadata.notifications.outdated.content": "ތިޔަ ބަދަލު ގެންނަ އައިޓަމް ޓެމްޕްލޭޓަށް މިހާރު އެހެން ފަރާތަކުން ވަނީ ބަދަލެއް ގެނޭސްފައެވެ. އެހެންވެ، މައްސަލަ ދިމާވިޔަ ނުދިނުމަށް ތިޔަ ގެނައި ބަދަލުތައް އުކާލެވިއްޖެއެވެ",

  "itemtemplate.edit.metadata.notifications.outdated.title": "ބަދަލުތައް ބާވެއްޖެ",

