  "admin.batch-import.title": "ބެޗް އިމޕޯޓްކުރޭ",

  "admin.metadata-import.page.header": "މެޓަޑޭޓާ އިމްޕޯޓްކުރޭ",

  "admin.batch-import.page.header": "ބެޗް އިމޕޯޓްކުރޭ",

  "admin.metadata-import.page.help": "ފައިލްތަކުގެ ބެޗް މެޓަޑޭޓާ މަސައްކަތްތައް ހިމެނޭ CSV ފައިލްތައް މިތަނަށް ޑްރޮޕް ނުވަތަ ބްރައުޒް ކުރެވޭނެއެވެ.",

  "admin.batch-import.page.help": "އިމްޕޯޓް ކުރަންވީ ކަލެކްޝަން ހިޔާރުކުރައްވާ. އެއަށްފަހު، އިމްޕޯޓް ކުރަންވީ ތަކެތި ހިމެނޭ Simple Archive Format (SAF) ޒިޕް ފައިލް މިތަނަށް ޑްރޮޕް ނުވަތަ ބްރައުޒް ކުރައްވާ.",

  "admin.batch-import.page.toggle.help": "ފައިލް އަޕްލޯޑް މެދުވެރިކޮށް ނުވަތަ URL މެދުވެރިކޮށް އިމްޕޯޓް ކުރެވިދާނެއެވެ. އިންޕުޓް ސޯސް ކަނޑައެޅުމަށް މަތީގައިވާ ޓޮގްލް ބޭނުންކުރައްވާ.",

  "admin.metadata-import.page.dropMsg": "އިމްޕޯޓް ކުރުމަށް މެޓަޑޭޓާ CSV އެއް ޑްރޮޕް ކުރައްވާ",

  "admin.batch-import.page.dropMsg": "އިމްޕޯޓް ކުރުމަށް ބެޗް ZIP އެއް ޑްރޮޕް ކުރައްވާ",

  "admin.metadata-import.page.dropMsgReplace": "އިމްޕޯޓް ކުރަންވީ މެޓަޑޭޓާ CSV ބަދަލުކުރުމަށް ޑްރޮޕް ކުރައްވާ",

  "admin.batch-import.page.dropMsgReplace": "އިމްޕޯޓް ކުރަންވީ ބެޗް ZIP ބަދަލުކުރުމަށް ޑްރޮޕް ކުރައްވާ",

