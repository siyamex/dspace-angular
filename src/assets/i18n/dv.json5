  "home.description": "",

  "home.breadcrumbs": "މައި ސަފުހާ",

  "home.search-form.placeholder": "ރިޕޮސިޓަރީ އިން ހޯއްދަވާ ...",

  "home.title": "މައި ސަފުހާ",

  "home.top-level-communities.head": "ޑީ-ސްޕޭސް ގައި ހިމެނޭ ކޮމިއުނިޓީތައް",

  "home.top-level-communities.help": "ކަލެކްޝަންތައް ބަލާލުމަށް ކޮމިއުނިޓީއެއް ހިޔާރުކުރައްވާ.",

  "info.accessibility-settings.breadcrumbs": "އެކްސެސިބިލިޓީ ސެޓިންގްސް",

  "info.accessibility-settings.cookie-warning": "އެކްސެސިބިލިޓީ ސެޓިންގްސް ސޭވްކުރެވޭކަށް ނެތެވެ. ސެޓިންގްސް ސޭވްކުރުމަށްޓަކައި ލޮގިން ވެލައްވާ، ނުވަތަ ސަފުހާގެ ތިރީގައިވާ 'ކުކީ ސެޓިންގްސް' އިން 'Accessibility Settings' ކުކީއަށް އެއްބަސްވެލައްވާ. އެއްބަސްވުމަށްފަހު ސަފުހާ ރިލޯޑް ކޮށްލުމުން މި މެސެޖު ފިލާނެއެވެ.",

  "info.accessibility-settings.disableNotificationTimeOut.label": "ވަކި ވަގުތެއް ފަހުން ނޮޓިފިކޭޝަންތައް އަމިއްލައަށް ލެއްޕޭ ގޮތް ހަދާ",

  "info.accessibility-settings.disableNotificationTimeOut.hint": "މި އޮޕްޝަން އޮން ކޮށްފައި ބެހެއްޓުމުން، ކަނޑައެޅިފައިވާ ވަގުތު ހަމަވުމުން ނޮޓިފިކޭޝަންތައް އަމިއްލައަށް ލެއްޕޭނެއެވެ. އޮފް ކޮށްފިނަމަ، އަމިއްލައަށް ލައްޕާލަންދެން ނޮޓިފިކޭޝަންތައް ފެންނަން ހުންނާނެއެވެ.",

  "info.accessibility-settings.failed-notification": "އެކްސެސިބިލިޓީ ސެޓިންގްސް ސޭވްއެއް ނުކުރެވުނު",

  "info.accessibility-settings.invalid-form-notification": "ސޭވްއެއް ނުކުރެވުނު. ފޯމުގައި ހުރި މައުލޫމާތު ރަނގަޅެއް ނޫނެވެ.",

  "info.accessibility-settings.liveRegionTimeOut.label": "ARIA ލައިވް ރީޖަން ޓައިމް-އައުޓް (ސިކުންތުން)",

  "info.accessibility-settings.liveRegionTimeOut.hint": "ARIA ލައިވް ރީޖަންގެ މެސެޖުތައް ފެންނަން ހުންނާނެ މުއްދަތު. ARIA ލައިވް ރީޖަންތަކަކީ ސަފުހާއިން ފެންނަން ހުންނަ އެއްޗެއް ނޫނެވެ، ނަމަވެސް ސްކްރީން ރީޑާ ބޭނުންކުރާ ފަރާތްތަކަށް ނޮޓިފިކޭޝަންތަކުގެ މައުލޫމާތު ފޯރުކޮށްދޭ އެއްޗެކެވެ.",

  "info.accessibility-settings.liveRegionTimeOut.invalid": "ލައިވް ރީޖަން ޓައިމް-އައުޓް 0 އަށްވުރެ ބޮޑުވާންވާނެއެވެ",

  "info.accessibility-settings.notificationTimeOut.label": "ނޮޓިފިކޭޝަން ޓައިމް-އައުޓް (ސިކުންތުން)",

  "info.accessibility-settings.notificationTimeOut.hint": "ނޮޓިފިކޭޝަން ފިލައިގެންދާނެ މުއްދަތު.",

  "info.accessibility-settings.notificationTimeOut.invalid": "ނޮޓިފިކޭޝަން ޓައިމް-އައުޓް 0 އަށްވުރެ ބޮޑުވާންވާނެއެވެ",

  "info.accessibility-settings.save-notification.cookie": "ސެޓިންގްސް ކާމިޔާބުކަމާއެކު ސޭވްކުރެވިއްޖެ.",

  "info.accessibility-settings.save-notification.metadata": "ޔޫޒާ ޕްރޮފައިލްގައި ސެޓިންގްސް ކާމިޔާބުކަމާއެކު ސޭވްކުރެވިއްޖެ.",

  "info.accessibility-settings.reset-failed": "ރިސެޓް ކުރެވޭގޮތެއް ނުވި. ލޮގިން ވެލައްވާ ނުވަތަ 'Accessibility Settings' ކުކީ ގަބޫލުކުރައްވާ.",

  "info.accessibility-settings.reset-notification": "ސެޓިންގްސް ކާމިޔާބުކަމާއެކު ރިސެޓްކުރެވިއްޖެ.",

  "info.accessibility-settings.reset": "ސެޓިންގްސް ރިސެޓްކުރޭ",

  "info.accessibility-settings.submit": "ސެޓިންގްސް ސޭވްކުރޭ",

  "info.accessibility-settings.title": "އެކްސެސިބިލިޓީ ސެޓިންގްސް",

  "info.end-user-agreement.accept": "އަހަރެން މި އެއްބަސްވުން ކިޔައިފީމެވެ، އަދި މިއަށް އެއްބަސްވަމެވެ",

  "info.end-user-agreement.accept.error": "އެއްބަސްވުން ގަބޫލުކުރުމުގެ ތެރޭގައި މައްސަލައެއް ދިމާވެއްޖެއެވެ",

