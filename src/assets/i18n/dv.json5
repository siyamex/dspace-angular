  "item.edit.bitstreams.headers.bundle": "ބަންޑަލް",

  "item.edit.bitstreams.headers.description": "ތަފްސީލު",

  "item.edit.bitstreams.headers.format": "ފޯމެޓް",

  "item.edit.bitstreams.headers.name": "ނަން",

  "item.edit.bitstreams.notifications.discarded.content": "ތިޔަ ގެނައި ބަދަލުތައް އުކާލެވިއްޖެއެވެ. ބަދަލުތައް އަލުން ގެނައުމަށް 'Undo' ފިތަށް ފިއްތާލައްވާ",

  "item.edit.bitstreams.notifications.discarded.title": "ބަދަލުތައް އުކާލެވިއްޖެ",

  "item.edit.bitstreams.notifications.move.failed.title": "ބިޓްސްޓްރީމްތަކުގެ މަގާމު ބަދަލުކުރުމުގައި މައްސަލައެއް",

  "item.edit.bitstreams.notifications.move.saved.content": "ބިޓްސްޓްރީމްތަކާއި ބަންޑަލްތަކުގެ މަގާމަށް ގެނައި ބަދަލުތައް ސޭވްކުރެވިއްޖެއެވެ.",

  "item.edit.bitstreams.notifications.move.saved.title": "ގެނައި ބަދަލުތައް ސޭވްކުރެވިއްޖެ",

  "item.edit.bitstreams.notifications.outdated.content": "ތިޔަ ބަދަލު ގެންނަ އައިޓަމަށް މިހާރު އެހެން ފަރާތަކުން ވަނީ ބަދަލެއް ގެނެސްފައެވެ. އެހެންވެ، މައްސަލައެއް ދިމާވިޔަ ނުދިނުމަށްޓަކައި ތިޔަ ގެނައި ބަދަލުތައް އުކާލެވިއްޖެއެވެ",

  "item.edit.bitstreams.notifications.outdated.title": "ބަދަލުތައް ބާވެއްޖެ (Outdated)",

  "item.edit.bitstreams.notifications.remove.failed.title": "ބިޓްސްޓްރީމް ފޮހެލުމުގައި މައްސަލައެއް",

  "item.edit.bitstreams.notifications.remove.saved.content": "ބިޓްސްޓްރީމް ފޮހެލުމަށް ގެނައި ބަދަލުތައް ސޭވްކުރެވިއްޖެއެވެ.",

  "item.edit.bitstreams.notifications.remove.saved.title": "ބަދަލުތައް ސޭވްކުރެވިއްޖެ",

  "item.edit.bitstreams.reinstate-button": "Undo",

  "item.edit.bitstreams.save-button": "ސޭވް",

  "item.edit.bitstreams.upload-button": "އަޕްލޯޑް",

  "item.edit.bitstreams.load-more.link": "އިތުރަށް ލޯޑްކުރޭ",

  "item.edit.delete.cancel": "ކެންސަލް",

  "item.edit.delete.confirm": "ފޮހެލާ",

  "item.edit.delete.description": "މި އައިޓަމް މުޅިން ފޮހެލަން ބޭނުންވާކަން ޔަގީންތަ؟ ސަމާލުކަމަށް: މިހާރު އޮތް ގޮތުންނަމަ، މި އައިޓަމްގެ އެއްވެސް ނިޝާނެއް (tombstone) ބާކީއެއް ނުހުންނާނެއެވެ.",

