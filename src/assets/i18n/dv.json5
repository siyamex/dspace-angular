  "bitstream.edit.authorizations.link": "ބިޓްސްޓްރީމްގެ ޕޮލިސީތަކަށް ބަދަލު ގެނޭ",

  "bitstream.edit.authorizations.title": "ބިޓްސްޓްރީމްގެ ޕޮލިސީތަކަށް ބަދަލު ގެނޭ",

  "bitstream.edit.return": "ފަހަތަށް",

  "bitstream.edit.bitstream": "ބިޓްސްޓްރީމް: ",

  "bitstream.edit.form.description.hint": "ފައިލްގެ ކުރު ތަފްސީލެއް ދެވިދާނެއެވެ، މިސާލަކަށް \"<i>މައިގަނޑު މަޒުމޫނު</i>\" ނުވަތަ \"<i>ތަޖުރިބާގެ ނަތީޖާތައް</i>\".",

  "bitstream.edit.form.description.label": "ތަފްސީލު",

  "bitstream.edit.form.embargo.hint": "ހުއްދަ ދެވޭ ފުރަތަމަ ދުވަސް. <b>މި ފޯމުން މި ތާރީހަށް ބަދަލެއް ނުގެނެވޭނެއެވެ.</b> ބިޓްސްޓްރީމަކަށް އެމްބާގޯ ތާރީހެއް ކަނޑައެޅުމަށްޓަކައި، <i>Item Status</i> ޓެބަށް ގޮސް، <i>Authorizations...</i> އަށް ފިއްތަވާލައްވާ، ބިޓްސްޓްރީމްގެ <i>READ</i> ޕޮލިސީ އުފައްދަވާ ނުވަތަ ބަދަލުކުރައްވާ، އަދި <i>Start Date</i> ބޭނުންވާ ގޮތަށް ކަނޑައަޅުއްވާ.",

  "bitstream.edit.form.embargo.label": "ވަކި ތާރީހަކާ ހަމައަށް އެމްބާގޯ ކުރޭ",

  "bitstream.edit.form.fileName.hint": "ބިޓްސްޓްރީމްގެ ފައިލް ނަން ބަދަލުކުރައްވާ. މިކަމުގެ ސަބަބުން ބިޓްސްޓްރީމްގެ URL ބަދަލުވާނެއެވެ، ނަމަވެސް ސީކުއެންސް އައިޑީ ބަދަލުނުވާހާ ހިނދަކު ބާލިންކްތައް މަސައްކަތް ކުރާނެއެވެ.",

  "bitstream.edit.form.fileName.label": "ފައިލް ނަން",

  "bitstream.edit.form.newFormat.label": "އާ ފޯމެޓް ސިފަކޮށްދީ",

  "bitstream.edit.form.newFormat.hint": "ފައިލް އުފެއްދުމަށް ބޭނުންކުރި އެޕްލިކޭޝަނާއި، އޭގެ ވާޝަން ނަންބަރު (މިސާލަކަށް: \"<i>ACMESoft SuperApp version 1.5</i>\").",

  "bitstream.edit.form.primaryBitstream.label": "މައިގަނޑު ފައިލް",

  "bitstream.edit.form.selectedFormat.hint": "ފޯމެޓް މަތީގައިވާ ލިސްޓުގައި ނެތްނަމަ، <b>މަތިން \"ލިސްޓުގައި ފޯމެޓް ނެތް\" ހިޔާރުކުރައްވާ</b> އަދި \"އާ ފޯމެޓް ސިފަކޮށްދީ\" ގެ ދަށުގައި އެ ސިފަކޮށްދެއްވާ.",

  "bitstream.edit.form.selectedFormat.label": "ހިޔާރުކުރެވިފައިވާ ފޯމެޓް",

  "bitstream.edit.form.selectedFormat.unknown": "ލިސްޓުގައި ފޯމެޓް ނެތް",

  "bitstream.edit.notifications.error.format.title": "ބިޓްސްޓްރީމްގެ ފޯމެޓް ސޭވްކުރުމުގައި މައްސަލައެއް ދިމާވެއްޖެ",

  "bitstream.edit.notifications.error.primaryBitstream.title": "މައިގަނޑު ބިޓްސްޓްރީމް ސޭވްކުރުމުގައި މައްސަލައެއް ދިމާވެއްޖ",

  "bitstream.edit.form.iiifLabel.label": "IIIF ލޭބަލް",

  "bitstream.edit.form.iiifLabel.hint": "މި ތަސްވީރުގެ ކެންވަސް ލޭބަލް. ނުދީފިނަމަ ޑިފޯލްޓް ލޭބަލް ބޭނުންކުރެވޭނެއެވެ.",

  "bitstream.edit.form.iiifToc.label": "IIIF ފިހުރިސްތު",

  "bitstream.edit.form.iiifToc.hint": "މިތަނަށް ލިޔުމެއް އިތުރުކުރުމުން މިއީ އާ ފިހުރިސްތު ރޭންޖެއްގެ ފެށުން ކަމުގައި ބެލެވޭނެއެވެ.",

  "bitstream.edit.form.iiifWidth.label": "IIIF ކެންވަސް ފުޅާމިން",

  "bitstream.edit.form.iiifWidth.hint": "ކެންވަސް ފުޅާމިން އާންމުކޮށް ހުންނަންވާނީ ތަސްވީރުގެ ފުޅާމިނާ އެއްވަރަށެވެ.",

  "bitstream.edit.form.iiifHeight.label": "IIIF ކެންވަސް އުސްމިން",

  "bitstream.edit.form.iiifHeight.hint": "ކެންވަސް އުސްމިން އާންމުކޮށް ހުންނަންވާނީ ތަސްވީރުގެ އުސްމިނާ އެއްވަރަށެވެ.",

  "bitstream.edit.notifications.saved.content": "މި ބިޓްސްޓްރީމަށް ގެނައި ބަދަލުތައް ސޭވް ކުރެވިއްޖެއެވެ.",

  "bitstream.edit.notifications.saved.title": "ބިޓްސްޓްރީމް ސޭވް ކުރެވިއްޖެ",

  "bitstream.edit.title": "ބިޓްސްޓްރީމަށް ބަދަލު ގެނޭ",

  "bitstream-request-a-copy.alert.canDownload1": "މި ފައިލަށް ވަނުމުގެ ހުއްދަ މިހާރުވެސް ތިޔަ ފަރާތަށް އެބައޮތެވެ. ފައިލް ޑައުންލޯޑް ކުރަން ބޭނުންނަމަ، މިތަނަށް ",

  "bitstream-request-a-copy.alert.canDownload2": "ފިއްތަވާލައްވާ",

  "bitstream-request-a-copy.header": "ފައިލްގެ ކޮޕީއަކަށް އެދި ހުށަހަޅާ",

  "bitstream-request-a-copy.intro": "ތިރީގައިވާ އައިޓަމްގެ ކޮޕީއަކަށް އެދުމަށްޓަކައި ތިރީގައިވާ މައުލޫމާތު ފުރިހަމަކުރައްވާ: ",

  "bitstream-request-a-copy.intro.bitstream.one": "މި ފައިލަށް އެދެނީ: ",

  "bitstream-request-a-copy.intro.bitstream.all": "ހުރިހާ ފައިލްތަކަކަށް އެދެނީ. ",

  "bitstream-request-a-copy.name.label": "ނަން *",

  "bitstream-request-a-copy.name.error": "ނަން ލިޔުމަކީ މަޖުބޫރު ކަމެކެވެ",

  "bitstream-request-a-copy.email.label": "އީމެއިލް އެޑްރެސް *",

  "bitstream-request-a-copy.email.hint": "މި އީމެއިލް އެޑްރެސް ބޭނުންކުރެވޭނީ ފައިލް ފޮނުވުމަށެވެ.",

  "bitstream-request-a-copy.email.error": "ސައްހަ އީމެއިލް އެޑްރެހެއް ލިޔުއްވާ.",

  "bitstream-request-a-copy.allfiles.label": "ފައިލްތައް",

  "bitstream-request-a-copy.files-all-false.label": "ހަމައެކަނި އެދުނު ފައިލް",

  "bitstream-request-a-copy.files-all-true.label": "މި އައިޓަމްގެ ހުރިހާ ހިފެހެއްޓިފައިވާ ފައިލްތައް",

  "bitstream-request-a-copy.message.label": "މެސެޖު",

  "bitstream-request-a-copy.return": "ފަހަތަށް",

  "bitstream-request-a-copy.submit": "ކޮޕީއަކަށް އެދޭ",

  "bitstream-request-a-copy.submit.success": "އައިޓަމަށް އެދި ކުރި ހުށަހެޅުން ކާމިޔާބުކަމާއެކު ފޮނުވިއްޖެއެވެ.",

  "bitstream-request-a-copy.submit.error": "އައިޓަމަށް އެދި ކުރި ހުށަހެޅުން ފޮނުވުމުގައި މައްސަލައެއް ދިމާވެއްޖެއެވެ.",

  "bitstream-request-a-copy.access-by-token.warning": "ތިޔަ ބައްލަވަނީ މުސައްނިފު ނުވަތަ ރެޕޮސިޓަރީގެ ފަރާތުން ދީފައިވާ ރައްކާތެރި އެކްސެސް ލިންކެއް މެދުވެރިކޮށް މި އައިޓަމެވެ. މި ލިންކު ހުއްދަ ނެތް ފަރާތްތަކާ ހިއްސާ ނުކުރުން މުހިންމެވެ.",

  "bitstream-request-a-copy.access-by-token.expiry-label": "މި ލިންކުން ލިބޭ ހުއްދައިގެ ވަގުތު ހަމަވާނީ",

  "bitstream-request-a-copy.access-by-token.expired": "މި ލިންކުން ދެން ވަނުމުގެ ހުއްދައެއް ނެތެވެ. ހުއްދައިގެ ވަގުތު ހަމަވެފައިވަނީ",

  "bitstream-request-a-copy.access-by-token.not-granted": "މި ލިންކުން ވަނުމުގެ ހުއްދައެއް ނެތެވެ. ހުއްދަ ނުދެނީ، ނުވަތަ ހުއްދަ ބާތިލުކުރީއެވެ.",

