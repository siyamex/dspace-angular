  "item.bitstreams.upload.notifications.bundle.created.title": "ބަންޑަލް އުފެއްދިއްޖެ",

  "item.bitstreams.upload.notifications.upload.failed": "އަޕްލޯޑް ކުރުން ނާކާމިޔާބުވެއްޖެއެވެ. އަލުން މަސައްކަތް ކުރުމުގެ ކުރިން މައުލޫމާތު ޗެކްކޮށްލައްވާ.",

