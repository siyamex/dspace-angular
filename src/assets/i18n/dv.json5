  "submission.workflow.generic.submit_select_reviewer": "ރިވިއުކުރާނެ ފަރާތެއް ހިޔާރުކުރޭ",

  "submission.workflow.generic.submit_select_reviewer-help": "",

  "submission.workflow.generic.submit_score": "ރޭޓްކުރޭ",

  "submission.workflow.generic.submit_score-help": "",

  "submission.workflow.tasks.claimed.approve": "ގަބޫލުކުރޭ",

  "submission.workflow.tasks.claimed.approve_help": "ތިޔަ ފަރާތުން އައިޓަމް ރިވިއުކޮށް ނިމުމުން، އެއީ ކަލެކްޝަނަށް އިތުރުކުރަން އެކަށީގެންވާ އެއްޗެއްނަމަ \"ގަބޫލުކުރޭ\" ހިޔާރުކުރޭ.",

  "submission.workflow.tasks.claimed.edit": "ބަދަލު ގެނޭ",

  "submission.workflow.tasks.claimed.edit_help": "އައިޓަމްގެ މެޓަޑޭޓާ ބަދަލުކުރުމަށް މި އޮޕްޝަން ހިޔާރުކުރޭ.",

  "submission.workflow.tasks.claimed.decline": "ދޫކޮށްލާ",

  "submission.workflow.tasks.claimed.decline_help": "",

  "submission.workflow.tasks.claimed.reject.reason.info": "މި ހުށަހެޅުން ރިޖެކްޓް ކުރާ ސަބަބު ތިރީގައިވާ ގޮޅީގައި ލިޔުއްވާ. އަދި ހުށަހެޅި ފަރާތުން މައްސަލަ ހައްލުކުރުމަށްފަހު އަލުން ހުށަހެޅިދާނެތޯ ބަޔާންކުރައްވާ.",

  "submission.workflow.tasks.claimed.reject.reason.placeholder": "ރިޖެކްޓް ކުރާ ސަބަބު ބަޔާންކުރައްވާ",

  "submission.workflow.tasks.claimed.reject.reason.submit": "އައިޓަމް ރިޖެކްޓް ކުރޭ",

  "submission.workflow.tasks.claimed.reject.reason.title": "ސަބަބު",

  "submission.workflow.tasks.claimed.reject.submit": "ރިޖެކްޓް",

  "submission.workflow.tasks.claimed.reject_help": "ތިޔަ ފަރާތުން އައިޓަމް ރިވިއުކޮށް ނިމުމުން، އެއީ ކަލެކްޝަނަށް އިތުރުކުރަން އެކަށީގެންވާ އެއްޗެއް <strong>ނޫން</strong> ކަމަށްވާނަމަ \"ރިޖެކްޓް\" ހިޔާރުކުރޭ. ދެން ތިޔަ ފަރާތް ކައިރީގައި ރިޖެކްޓް ކުރާ ސަބަބު ލިޔުމަށް އެދޭނެއެވެ.",

  "submission.workflow.tasks.claimed.return": "އަނބުރާ ޕޫލަށް ފޮނުވާ",

  "submission.workflow.tasks.claimed.return_help": "މި މަސައްކަތް އަލުން ޕޫލަށް ފޮނުވާލާ، އޭރުން އެހެން ޔޫޒަރަކަށް މި މަސައްކަތާ ހަވާލުވެވިދާނެއެވެ.",

  "submission.workflow.tasks.generic.error": "މަސައްކަތް ކުރިއަށް ދަނިކޮށް މައްސަލައެއް ދިމާވެއްޖެ...",

