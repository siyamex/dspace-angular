  "system-wide-alert.form.label.message": "އެލާޓް މެސެޖް",

  "system-wide-alert.form.label.countdownTo.enable": "ކައުންޓްޑައުން ޓައިމަރެއް ބޭނުންކުރޭ",

  "system-wide-alert.form.label.countdownTo.hint": "އިރުޝާދު: ކައުންޓްޑައުން ޓައިމަރެއް ކަނޑައަޅާށެވެ. މިއީ ކުރިމަގުގެ ތާރީހަކަށް ކައުންޓްޑައުން ކުރުމަށް ބޭނުންކުރެވޭ އެއްޗެކެވެ. މި ޓައިމަރު ހަމަވުމުން ބެނާ ފޮރުވޭނެއެވެ. ނަމަވެސް ސާވަރު އަމިއްލައަކަށް ނުހުއްޓޭނެއެވެ.",

