  "admin.metadata-import.page.validateOnly": "ހަމައެކަނި ޗެކްކޮށްލުމަށް",

  "admin.metadata-import.page.validateOnly.hint": "މި ހިޔާރުކުރުމުން، އަޕްލޯޑްކުރި CSV ޗެކްކޮށްލެވޭނެއެވެ. ފާހަގަވި ބަދަލުތަކުގެ ރިޕޯޓެއް ލިބޭނެއެވެ، ނަމަވެސް އެއްވެސް ބަދަލެއް ސޭވްއެއް ނުކުރެވޭނެއެވެ.",

