  "submission.sections.accesses.form.access-condition-label": "އެކްސެސް ހާލަތުގެ ވައްތަރު",

  "submission.sections.accesses.form.access-condition-hint": "ހުށަހެޅުމަށްފަހު މި އައިޓަމަށް ކަނޑައަޅާނެ އެކްސެސް ހާލަތެއް ހިޔާރުކުރޭ",

