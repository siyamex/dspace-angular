  "error.validation.groupExists": "މި ގްރޫޕް މިހާރުވެސް އެބައޮތެވެ",

  "error.validation.metadata.name.invalid-pattern": "މިތަނުގައި ތިކި (.)، ކޮމާ (,) ނުވަތަ ހުސްތަން (space) ބޭނުން ނުކުރެވޭނެއެވެ. ބަދަލުގައި Element އަދި Qualifier ބޭނުންކުރައްވާ",

