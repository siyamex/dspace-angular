  "person.page.orcid.sync-queue.send.validation-error.organization.address-required": "އޮގަނައިޒޭޝަންގެ އެޑްރެސް ލިޔަން ޖެހޭނެ",

  "person.page.orcid.sync-queue.send.validation-error.organization.city-required": "އޮގަނައިޒޭޝަން ހުންނަ ސިޓީ ލިޔަން ޖެހޭނެ",

  "person.page.orcid.sync-queue.send.validation-error.organization.country-required": "އޮގަނައިޒޭޝަން ހުންނަ ގައުމުގެ ISO 3166 ކޯޑު ލިޔަން ޖެހޭނެ",

  "person.page.orcid.sync-queue.send.validation-error.disambiguated-organization.required": "އޮގަނައިޒޭޝަން ވަކިކޮށް ދެނެގަތުމަށް އައިޑެންޓިފައިޔާއެއް ބޭނުންވެއެވެ. ބޭނުންކުރެވޭ އައިޑީތަކަކީ GRID, Ringgold, LEIs އަދި Crossref Funder Registry އައިޑީތަކެވެ",

  "person.page.orcid.sync-queue.send.validation-error.disambiguated-organization.value-required": "އޮގަނައިޒޭޝަންގެ އައިޑެންޓިފައިޔާގެ އަގު (Value) ލިޔަން ޖެހޭނެ",

  "person.page.orcid.sync-queue.send.validation-error.disambiguation-source.required": "އޮގަނައިޒޭޝަންގެ އައިޑެންޓިފައިޔާގެ މަސްދަރު (Source) ލިޔަން ޖެހޭނެ",

  "person.page.orcid.sync-queue.send.validation-error.disambiguation-source.invalid": "އޮގަނައިޒޭޝަންގެ އައިޑެންޓިފައިޔާގެ މަސްދަރު ސައްހައެއް ނޫނެވެ. ބޭނުންކުރެވޭ މަސްދަރުތަކަކީ RINGGOLD, GRID, LEI އަދި FUNDREF އެވެ",

  "person.page.orcid.synchronization-mode": "ސިންކްރޮނައިޒޭޝަން މޯޑް",

  "person.page.orcid.synchronization-mode.batch": "ބެޗް",

  "person.page.orcid.synchronization-mode.label": "ސިންކްރޮނައިޒޭޝަން މޯޑް",

  "person.page.orcid.synchronization-mode-message": "ORCID އާ ސިންކްރޮނައިޒް ކުރާނެ ގޮތެއް ހިޔާރުކުރައްވާ. އޮޕްޝަންތަކުގެ ތެރޭގައި ހިމެނެނީ \"މެނުއަލް\" (ތިޔަ ފަރާތުން އަމިއްލައަށް މައުލޫމާތު ފޮނުވަން ޖެހޭނެ) ނުވަތަ \"ބެޗް\" (ސިސްޓަމުން އަމިއްލައަށް ތާވަލަކާ އެއްގޮތަށް މައުލޫމާތު ފޮނުވާނެ) އެވެ.",

  "person.page.orcid.synchronization-mode-funding-message": "ތިޔަ ފަރާތުގެ މަޝްރޫއުތަކުގެ (Project) މައުލޫމާތު ORCID ރެކޯޑަށް ފޮނުވަން ބޭނުންތޯ ހިޔާރުކުރައްވާ.",

  "person.page.orcid.synchronization-mode-publication-message": "ތިޔަ ފަރާތުގެ ޕަބްލިކޭޝަންތަކުގެ (Publication) މައުލޫމާތު ORCID ރެކޯޑަށް ފޮނުވަން ބޭނުންތޯ ހިޔާރުކުރައްވާ.",

  "person.page.orcid.synchronization-mode-profile-message": "ތިޔަ ފަރާތުގެ ބައޮގްރަފިކަލް މައުލޫމާތު ނުވަތަ އައިޑެންޓިފައިޔާތައް ORCID ރެކޯޑަށް ފޮނުވަން ބޭނުންތޯ ހިޔާރުކުރައްވާ.",

  "person.page.orcid.synchronization-settings-update.success": "ސިންކްރޮނައިޒޭޝަން ސެޓިންގްސް ކާމިޔާބުކަމާއެކު އައުކުރެވިއްޖެ",

  "person.page.orcid.synchronization-settings-update.error": "ސިންކްރޮނައިޒޭޝަން ސެޓިންގްސް އައުކުރުން ނާކާމިޔާބުވެއްޖެ",

