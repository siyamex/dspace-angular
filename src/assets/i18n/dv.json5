  "submission.sections.duplicates.in-workspace": "މި އައިޓަމް ވަނީ ވޯކްސްޕޭސްގައެވެ",

  "submission.sections.duplicates.in-workflow": "މި އައިޓަމް ވަނީ ވޯކްފްލޯގައެވެ",

  "submission.sections.license.granted-label": "އަހަރެން މަތީގައިވާ ލައިސަންސް ގަބޫލުކުރަން",

