  "access-control-limit-to-specific": "ވަކި ހާއްސަ ބިޓްސްޓްރީމްތަކަކަށް ބަދަލުތައް މަހްދޫދުކުރޭ",

  "access-control-process-all-bitstreams": "އައިޓަމްގައިވާ ހުރިހާ ބިޓްސްޓްރީމެއް އައުކުރޭ",

  "access-control-bitstreams-selected": "ބިޓްސްޓްރީމް ހިޔާރުކުރެވިއްޖެ",

  "access-control-bitstreams-select": "ބިޓްސްޓްރީމްތައް ހިޔާރުކުރޭ",

  "access-control-cancel": "ކެންސަލް",

  "access-control-execute": "ކުރިއަށް ގެންދޭ",

  "access-control-add-more": "އިތުރުކުރޭ",

  "access-control-remove": "އެކްސެސް ހާލަތު އުނިކުރޭ",

  "access-control-select-bitstreams-modal.title": "ބިޓްސްޓްރީމްތައް ހިޔާރުކުރޭ",

  "access-control-select-bitstreams-modal.no-items": "ދައްކާނެ އެއްވެސް އެއްޗެއް ނެތް.",

  "access-control-select-bitstreams-modal.close": "ބަންދުކޮށްލާ",

  "access-control-option-label": "އެކްސެސް ހާލަތުގެ ވައްތަރު",

  "access-control-option-note": "ހިޔާރުކުރެވިފައިވާ އޮބްޖެކްޓްތަކަށް ކަނޑައަޅާނެ އެކްސެސް ހާލަތެއް ހިޔާރުކުރޭ.",

  "access-control-option-start-date": "އެކްސެސް ދޭން ފަށާ ތާރީހު",

  "access-control-option-start-date-note": "މި ހާލަތު ހިނގަން ފަށާނެ ތާރީހެއް ހިޔާރުކުރޭ",

  "access-control-option-end-date": "އެކްސެސް ދޭން ނިމޭ ތާރީހު",

  "access-control-option-end-date-note": "މި ހާލަތު ނިމޭނެ ތާރީހެއް ހިޔާރުކުރޭ",

  "vocabulary-treeview.search.form.add": "އިތުރުކުރޭ",

  "admin.notifications.publicationclaim.breadcrumbs": "ޕަބްލިކޭޝަން ކްލެއިމް",

  "admin.notifications.publicationclaim.page.title": "ޕަބްލިކޭޝަން ކްލެއިމް",

  "coar-notify-support.title": "COAR Notify Protocol",

  "coar-notify-support-title.content": "މިތަނުން COAR Notify ޕްރޮޓޮކޯލަށް ފުރިހަމައަށް ސަޕޯޓްކުރެއެވެ. މިއީ ރިޕޮސިޓަރީތަކުގެ މެދުގައި މައުލޫމާތު ބަދަލުކުރުމަށް ފަރުމާކުރެވިފައިވާ ނިޒާމެކެވެ. އިތުރު މައުލޫމާތު ހޯއްދެވުމަށް <a href=\"https://notify.coar-repositories.org/\" rel=\"noopener noreferrer\">COAR Notify ވެބްސައިޓަށް</a> ޒިޔާރަތް ކުރައްވާ.",

  "coar-notify-support.ldn-inbox.title": "LDN އިންބޮކްސް",

  "coar-notify-support.ldn-inbox.content": "ތިޔަ ފަރާތުގެ ފަސޭހައަށްޓަކައި، އަޅުގަނޑުމެންގެ LDN (Linked Data Notifications) އިންބޮކްސް {{ ldnInboxUrl }} އިން ފެންނަން ހުންނާނެއެވެ. މި އިންބޮކްސް މެދުވެރިކޮށް ފަސޭހަކަމާއެކު މައުލޫމާތު ބަދަލުކުރެވޭނެއެވެ.",

  "coar-notify-support.message-moderation.title": "މެސެޖް މޮޑަރޭޝަން",

  "coar-notify-support.message-moderation.content": "ރައްކާތެރިކަން ކަށަވަރުކުރުމަށްޓަކައި، ލިބޭ ހުރިހާ LDN މެސެޖްތަކެއް މޮޑަރޭޓް ކުރެވޭނެއެވެ. މައުލޫމާތު ބަދަލުކުރުމަށް ބޭނުންފުޅުނަމަ، އަޅުގަނޑުމެންގެ ހާއްސަ",

  "coar-notify-support.message-moderation.feedback-form": " ފީޑްބެކް ފޯމް މެދުވެރިކޮށް ގުޅުއްވާ.",

