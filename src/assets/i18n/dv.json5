  "community.edit.logo.notifications.delete.success.title": "ލޯގޯ ފޮހެލެވިއްޖ",

  "community.edit.logo.notifications.delete.success.content": "ކޮމިއުނިޓީގެ ލޯގޯ ކާމިޔާބުކަމާއެކު ފޮހެލެވިއްޖެއެވެ",

  "community.edit.logo.notifications.delete.error.title": "ލޯގޯ ފޮހެލުމުގައި މައްސަލައެއް",

  "community.edit.logo.upload": "އަޕްލޯޑް ކުރުމަށް ކޮމިއުނިޓީ ލޯގޯއެއް ޑްރޮޕް ކުރައްވާ",

  "community.edit.notifications.success": "ކޮމިއުނިޓީއަށް ކާމިޔާބުކަމާއެކު ބަދަލު ގެނެވިއްޖެއެވެ",

  "community.edit.notifications.unauthorized": "މި ބަދަލު ގެނައުމުގެ ހުއްދަ ތިޔަ ފަރާތަކަށް ނެތެވެ",

