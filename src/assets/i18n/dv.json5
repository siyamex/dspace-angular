  "submission.workflow.tasks.pool.hide-detail": "ތަފްސީލު ފޮރުވާ",

  "submission.workflow.tasks.pool.show-detail": "ތަފްސީލު ދައްކާ",

  "submission.workflow.tasks.duplicates": "މި އައިޓަމާ އެއްގޮތް ތަކެތި ފެނިއްޖެ. ތަފްސީލު ބަލާލުމަށް މި އައިޓަމާ ހަވާލުވެ ބަދަލު ގެންނަވާ.",

