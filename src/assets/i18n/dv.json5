  "admin.access-control.groups.form.notification.created.failure.groupNameInUse": "ގްރޫޕް \"{{name}}\" އުފެއްދުމުގައި ނާކާމިޔާބުވެއްޖެއެވެ. އެ ނަމަކީ މިހާރުވެސް ބޭނުންކުރެވެމުންދާ ނަމެއްތޯ ޔަގީންކުރައްވާ.",

