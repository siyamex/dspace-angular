  "grant-deny-request-copy.revoke": "އެކްސެސް އަނބުރާ ގެންދޭ",

  "grant-deny-request-copy.email.back": "ފަހަތަށް",

  "grant-deny-request-copy.email.message": "އިތުރު މެސެޖެއް (އިހުތިޔާރީ)",

  "grant-deny-request-copy.email.message.empty": "މެސެޖެއް ލިޔުއްވާ",

  "grant-deny-request-copy.email.permissions.info": "މި ފުރުސަތުގައި ލިޔުމަށް އޮތް އެކްސެސް ހިފަހައްޓާފައިވާ މިންވަރު މުރާޖައާ ކުރެވިދާނެއެވެ. މި ހިފަހައްޓާފައިވާ މިންވަރުތައް ނައްތާލުމަށް ރިޕޮސިޓަރީ އެޑްމިނިސްޓްރޭޓަރުންގެ ކިބައިން އެދެން ބޭނުންނަމަ، ތިރީގައިވާ ގޮޅީގައި ފާހަގަ ޖައްސަވާ.",

  "grant-deny-request-copy.email.permissions.label": "އޯޕަން އެކްސެސް އަށް ބަދަލުކުރޭ",

  "grant-deny-request-copy.email.send": "ފޮނުވާ",

  "grant-deny-request-copy.email.subject": "ސުރުހީ",

  "grant-deny-request-copy.email.subject.empty": "ސުރުހީއެއް ލިޔުއްވާ",

  "grant-deny-request-copy.grant": "އެކްސެސް ރިކުއެސްޓް ގަބޫލުކުރޭ",

  "grant-deny-request-copy.header": "ލިޔުމުގެ ކޮޕީއަކަށް އެދުން",

  "grant-deny-request-copy.home-page": "މައި ސަފުހާއަށް ދާން ބޭނުން",

  "grant-deny-request-copy.intro1": "ތިޔައީ <a href='{{ url }}'>{{ name }}</a> ލިޔުމުގެ މުސައްނިފުންގެ ތެރެއިން ފަރާތެއްނަމަ، ތިރީގައިވާ ގޮތްތަކުގެ ތެރެއިން ގޮތެއް ބޭނުންކޮށްގެން ޔޫޒަރަށް ޖަވާބު ދެއްވާ.",

  "grant-deny-request-copy.intro2": "ގޮތެއް ހިޔާރުކުރުމުން، ޖަވާބުގައި ފޮނުވޭނެ އީމެއިލްގެ ނަމޫނާއެއް ފެންނާނެއެވެ. ބޭނުންނަމަ އެއަށް ބަދަލު ގެނެވޭނެއެވެ.",

  "grant-deny-request-copy.previous-decision": "މި ހުށަހެޅުމަށް ކުރިން ވަނީ ސެކިއުރިޓީ އެކްސެސް ޓޯކަންއަކާއެކު ހުއްދަ ދެވިފައެވެ. މިހާރު ބޭނުންނަމަ އެ ހުއްދަ ބާތިލުކުރެވިދާނެއެވެ",

  "grant-deny-request-copy.processed": "މި ހުށަހެޅުމާ މެދު މިހާރު ވަނީ ގޮތެއް ނިންމިފައެވެ. ތިރީގައިވާ ފިތުން މައި ސަފުހާއަށް ދެވޭނެއެވެ.",

  "grant-request-copy.email.subject": "ލިޔުމުގެ ކޮޕީއަކަށް އެދުން",

  "grant-request-copy.error": "މައްސަލައެއް ދިމާވެއްޖެއެވެ",

  "grant-request-copy.header": "ލިޔުމުގެ ކޮޕީއަށް ހުއްދަ ދީފި",

  "grant-request-copy.intro.attachment": "ހުށަހެޅި ފަރާތަށް މެސެޖެއް ފޮނުވޭނެއެވެ. އަދި އެދުނު ލިޔުންތައް އެޓޭޗްމަންޓެއްގެ ގޮތުގައި ފޮނުވޭނެއެވެ.",

  "grant-request-copy.intro.link": "ހުށަހެޅި ފަރާތަށް މެސެޖެއް ފޮނުވޭނެއެވެ. އަދި ލިޔުންތަކަށް ވަދެވޭނެ ރައްކާތެރި ލިންކެއް ފޮނުވޭނެއެވެ. މި ލިންކް ބޭނުންކުރެވޭނީ ތިރީގައިވާ \"އެކްސެސް މުއްދަތު\" ގައި ހިޔާރުކުރާ ވަގުތަށެވެ.",

  "grant-request-copy.intro.link.preview": "ތިރީގައި އެވަނީ ހުށަހެޅި ފަރާތަށް ފޮނުވޭނެ ލިންކްގެ ޕްރިވިއުއެކެވެ:",

  "grant-request-copy.success": "އައިޓަމް ރިކުއެސްޓަށް ކާމިޔާބުކަމާއެކު ހުއްދަ ދެވިއްޖެއެވެ",

