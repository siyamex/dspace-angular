  "community.listelement.badge": "ކޮމިއުނިޓީ",

  "community.logo": "ކޮމިއުނިޓީ ލޯގޯ",

  "comcol-role.edit.no-group": "ނެތް",

  "comcol-role.edit.create": "އުފައްދާ",

  "comcol-role.edit.create.error.title": "'{{ role }}' ރޯލަށް ގްރޫޕެއް އުފެއްދުން ނާކާމިޔާބުވެއްޖެ",

  "comcol-role.edit.restrict": "ހިފަހައްޓާ",

  "comcol-role.edit.delete": "ފޮހެލާ",

  "comcol-role.edit.delete.error.title": "'{{ role }}' ރޯލްގެ ގްރޫޕް ފޮހެލުން ނާކާމިޔާބުވެއްޖެ",

  "comcol-role.edit.delete.modal.header": "ގްރޫޕް \"{{ dsoName }}\" ފޮހެލާ",

  "comcol-role.edit.delete.modal.info": "ގްރޫޕް \"{{ dsoName }}\" އާއި އެއާ ގުޅުންހުރި ހުރިހާ ޕޮލިސީތަކެއް ފޮހެލަން ބޭނުންވާކަން ޔަގީންތަ؟",

  "comcol-role.edit.delete.modal.cancel": "ކެންސަލް",

  "comcol-role.edit.delete.modal.confirm": "ފޮހެލާ",

  "comcol-role.edit.community-admin.name": "އެޑްމިނިސްޓްރޭޓަރުން",

  "comcol-role.edit.collection-admin.name": "އެޑްމިނިސްޓްރޭޓަރުން",

  "comcol-role.edit.community-admin.description": "ކޮމިއުނިޓީ އެޑްމިނިސްޓްރޭޓަރުންނަށް ސަބް-ކޮމިއުނިޓީ ނުވަތަ ކަލެކްޝަންތައް އުފެއްދިދާނެއެވެ، އަދި އެތަންތަން ބެލެހެއްޓުން އެހެން ފަރާތްތަކާ ހަވާލުކުރެވިދާނެއެވެ. މީގެ އިތުރުން، ކަލެކްޝަންތަކަށް އައިޓަމް ހުށަހެޅޭނީ ކޮން ބަޔަކަށްތޯއާއި، ހުށަހަޅާފައިވާ ތަކެތީގެ މެޓަޑޭޓާއަށް ބަދަލު ގެނައުމުގެ ހުއްދަ ކަނޑައަޅާނީވެސް އެފަރާތްތަކުންނެވެ.",

  "comcol-role.edit.collection-admin.description": "ކަލެކްޝަން އެޑްމިނިސްޓްރޭޓަރުން ކަނޑައަޅާނީ ކަލެކްޝަނަށް އައިޓަމް ހުށަހެޅޭނީ ކޮން ބަޔަކަށްތޯއާއި، ހުށަހަޅާފައިވާ ތަކެތީގެ މެޓަޑޭޓާއަށް ބަދަލު ގެނައުމުގެ ހުއްދައެވެ.",

  "comcol-role.edit.submitters.name": "ހުށަހަޅާ ފަރާތްތައް",

  "comcol-role.edit.submitters.description": "މި ކަލެކްޝަނަށް އާ އައިޓަމް ހުށަހެޅުމުގެ ހުއްދަ އޮތް އީ-ޕީޕަލް އަދި ގްރޫޕްތައް.",

  "comcol-role.edit.item_read.name": "ޑިފޯލްޓް އައިޓަމް ރީޑް އެކްސެސް",

  "comcol-role.edit.item_read.description": "މި ކަލެކްޝަނަށް އަލަށް ހުށަހަޅާ އައިޓަމްތައް ބަލާލުމުގެ ހުއްދަ އޮތް އީ-ޕީޕަލް އަދި ގްރޫޕްތައް. މި ރޯލަށް ގެންނަ ބަދަލުތައް ކުރިން ހުރި އައިޓަމްތަކަކަށް ނުހިނގާނެއެވެ.",

  "comcol-role.edit.item_read.anonymous-group": "އަލަށް އަންނަ އައިޓަމްތައް ބެލުމުގެ ޑިފޯލްޓް ހުއްދަ މިހާރު އިނީ އެނޮނިމަސް (Anonymous) ކޮށް.",

  "comcol-role.edit.bitstream_read.name": "ޑިފޯލްޓް ބިޓްސްޓްރީމް ރީޑް އެކްސެސް",

  "comcol-role.edit.bitstream_read.description": "މި ކަލެކްޝަނަށް އަލަށް ހުށަހަޅާ ބިޓްސްޓްރީމްތައް ބަލާލުމުގެ ހުއްދަ އޮތް އީ-ޕީޕަލް އަދި ގްރޫޕްތައް. މި ރޯލަށް ގެންނަ ބަދަލުތައް ކުރިން ހުރި ބިޓްސްޓްރީމްތަކަކަށް ނުހިނގާނެއެވެ.",

  "comcol-role.edit.bitstream_read.anonymous-group": "އަލަށް އަންނަ ބިޓްސްޓްރީމްތައް ބެލުމުގެ ޑިފޯލްޓް ހުއްދަ މިހާރު އިނީ އެނޮނިމަސް (Anonymous) ކޮށް.",

  "comcol-role.edit.editor.name": "އެޑިޓަރުން",

  "comcol-role.edit.editor.description": "އެޑިޓަރުންނަށް ހުށަހަޅާ ތަކެތީގެ މެޓަޑޭޓާއަށް ބަދަލު ގެނެވޭނެއެވެ، އަދި އެތަކެތި ބަލައިގަތުން ނުވަތަ ބާތިލުކުރުމުގެ ހުއްދަ އޮންނާނެއެވެ.",

  "comcol-role.edit.finaleditor.name": "ފައިނަލް އެޑިޓަރުން",

  "comcol-role.edit.finaleditor.description": "ފައިނަލް އެޑިޓަރުންނަށް ހުށަހަޅާ ތަކެތީގެ މެޓަޑޭޓާއަށް ބަދަލު ގެނެވޭނެއެވެ، ނަމަވެސް އެތަކެތި ބާތިލުކުރުމުގެ ހުއްދައެއް ނޯންނާނެއެވެ.",

  "comcol-role.edit.reviewer.name": "ރިވިއުކުރާ ފަރާތްތައް",

  "comcol-role.edit.reviewer.description": "ރިވިއުކުރާ ފަރާތްތަކަށް ހުށަހަޅާ ތަކެތި ބަލައިގަތުން ނުވަތަ ބާތިލުކުރުމުގެ ހުއްދަ އޮންނާނެއެވެ. ނަމަވެސް، މެޓަޑޭޓާއަށް ބަދަލު ގެނައުމުގެ ހުއްދައެއް ނޯންނާނެއެވެ.",

