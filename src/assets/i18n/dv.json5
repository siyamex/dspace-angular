  "item.edit.bitstreams.edit.buttons.undo": "ބަދަލުތައް އަނބުރާ ގެނޭ",

  "item.edit.bitstreams.edit.live.cancel": "{{ bitstream }} ވަނީ އަނބުރާ މަގާމު {{ toIndex }} އަށް ގެނެވިފައެވެ، އަދި މިހާރު ހިޔާރުކުރެވިފައެއް ނެތެވެ.",

  "item.edit.bitstreams.edit.live.clear": "{{ bitstream }} މިހާރު ހިޔާރުކުރެވިފައެއް ނެތެވެ.",

  "item.edit.bitstreams.edit.live.loading": "މަގާމު ބަދަލުކޮށް ނިމެންދެން މަޑުކޮށްލައްވާ.",

  "item.edit.bitstreams.edit.live.select": "{{ bitstream }} ހިޔާރުކުރެވިއްޖެ.",

  "item.edit.bitstreams.edit.live.move": "{{ bitstream }} މިހާރު އޮތީ މަގާމު {{ toIndex }} ގައެވެ.",

  "item.edit.bitstreams.empty": "މި އައިޓަމްގައި އެއްވެސް ބިޓްސްޓްރީމެއް ނެތެވެ. ބިޓްސްޓްރީމެއް އުފެއްދުމަށް 'އަޕްލޯޑް' ފިތަށް ފިއްތާލައްވާ.",

  "item.edit.bitstreams.info-alert": "ބަންޑަލްގެ ތެރޭގައި ހުރި ބިޓްސްޓްރީމްތަކުގެ ތަރުތީބު ބަދަލުކުރުމަށް، ޑްރެގް ހޭންޑަލްގައި ހިފަހައްޓައިގެން މައުސްއިން ދަމާލާށެވެ. މީގެ އިތުރުން ކީބޯޑުންވެސް ތަރުތީބު ބަދަލުކުރެވޭނެއެވެ: ޑްރެގް ހޭންޑަލްއަށް ފޯކަސް ގެނައުމަށްފަހު އެންޓާ (enter) އަށް ފިއްތާލައިގެން ބިޓްސްޓްރީމް ހިޔާރުކުރާށެވެ. ދެން ތީރު ކީތައް (arrow keys) ބޭނުންކޮށްގެން މައްޗަށް ނުވަތަ ތިރިއަށް ބަދަލުކުރާށެވެ. ތަރުތީބު ޔަގީންކުރުމަށް އަލުން އެންޓާ އަށް ފިއްތާލާށެވެ.",

