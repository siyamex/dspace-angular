  "submission.sections.custom-url.label.previous-urls": "ކުރީގެ URL ތައް",

  "submission.sections.custom-url.alert.info": "މިތަނުގައި ކަސްޓަމް URL އެއް ކަނޑައަޅާށެވެ. މި URL ބޭނުންކޮށްގެން މި އައިޓަމަށް ވަދެވޭނެއެވެ. ",

