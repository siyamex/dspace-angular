  "register-page.registration.aria.label": "ތިޔަ ފަރާތުގެ އީމެއިލް އެޑްރެސް ލިޔުއްވާ",

  "forgot-email.form.aria.label": "ތިޔަ ފަރާތުގެ އީމެއިލް އެޑްރެސް ލިޔުއްވާ",

  "search-facet-option.update.announcement": "ސަފުހާ އަލުން ލޯޑްވާނެއެވެ. ފިލްޓާ {{ filter }} ހިޔާރުކުރެވިއްޖެ.",

  "live-region.ordering.instructions": "މިތަކެތި ތަރުތީބު ކުރުމަށް ސްޕޭސްބާ ބޭނުންކުރައްވާ {{ itemName }}.",

  "live-region.ordering.status": "{{ itemName }} ހިފަހައްޓައިފި. މިހާރު ހުރި ތަރުތީބު: {{ length }} ގެ ތެރެއިން {{ index }}. ތަރުތީބު ބަދަލުކުރުމަށް މައްޗާއި ތިރީ އެރޯ ބޭނުންކުރައްވާ، ބަހައްޓަން ސްޕޭސްބާ، ކެންސަލް ކުރަން އެސްކޭޕް.",

  "live-region.ordering.moved": "{{ itemName }}، {{ length }} ގެ ތެރެއިން {{ index }} ވަނަ މަގާމަށް ބަދަލުކުރެވިއްޖެ. ތަރުތީބު ބަދަލުކުރުމަށް މައްޗާއި ތިރީ އެރޯ ބޭނުންކުރައްވާ، ބަހައްޓަން ސްޕޭސްބާ، ކެންސަލް ކުރަން އެސްކޭޕް.",

  "live-region.ordering.dropped": "{{ itemName }}، {{ length }} ގެ ތެރެއިން {{ index }} ވަނަ މަގާމަށް ބެހެއްޓިއްޖެ.",

  "dynamic-form-array.sortable-list.label": "ތަރުތީބު ކުރެވޭ ލިސްޓް",

  "external-login.component.or": "ނުވަތަ",

  "external-login.confirmation.header": "ލޮގިންވުމުގެ މަސައްކަތް ނިންމުމަށް ބައެއް މައުލޫމާތު ބޭނުންވެއެވެ",

  "external-login.noEmail.informationText": "{{authMethod}} އިން ލިބުނު މައުލޫމާތު ލޮގިންވުމަށް ފުދޭވަރެއް ނޫނެވެ. އުނިވާ މައުލޫމާތު ތިރީގައި ލިޔުއްވާ، ނުވަތަ ތިޔަ ފަރާތުގެ {{authMethod}} މިހާރު ހުރި އެކައުންޓަކާ ގުޅުވުމަށް އެހެން ގޮތަކުން ލޮގިންވެލައްވާ.",

  "external-login.haveEmail.informationText": "ހީވާ ގޮތުން މި ސިސްޓަމްގައި ތިޔަ ފަރާތުގެ އެކައުންޓެއް އަދި ނެތެވެ. އެހެން ކަމަށްވާނަމަ، {{authMethod}} އިން ލިބުނު މައުލޫމާތު ކަށަވަރު ކޮށްދެއްވާ، އޭރުން އައު އެކައުންޓެއް އުފެއްދޭނެއެވެ. ނުވަތަ މިހާރު އެކައުންޓެއް އޮތްނަމަ، އީމެއިލް އެޑްރެސް މިހާރު ބޭނުންކުރާ އެޑްރެހާ އެއްގޮތް ކުރައްވާ ނުވަތަ އެހެން ގޮތަކުން ލޮގިންވެލައްވާ.",

  "external-login.confirm-email.header": "އީމެއިލް ކަށަވަރުކުރޭ ނުވަތަ އައުކުރޭ",

  "external-login.confirmation.email-required": "އީމެއިލް ލިޔަން ޖެހޭނެ.",

  "external-login.confirmation.email-label": "ޔޫޒަރުގެ އީމެއިލް",

  "external-login.confirmation.email": "އީމެއިލް",

  "external-login.confirmation.email-invalid": "އީމެއިލް ފޯމެޓް ސައްހައެއް ނޫން.",

  "external-login.confirm.button.label": "މި އީމެއިލް ކަށަވަރުކުރޭ",

  "external-login.confirm-email-sent.header": "ކަށަވަރުކުރުމުގެ އީމެއިލް ފޮނުވިއްޖެ",

  "external-login.confirm-email-sent.info": " ތިޔަ ފަރާތުން ދެއްވި އީމެއިލް އެޑްރެހަށް ކަށަވަރުކުރުމުގެ އީމެއިލެއް ފޮނުވައިފީމެވެ. <br> ލޮގިންވުމުގެ މަސައްކަތް ނިންމުމަށް އެ އީމެއިލްގައިވާ އިރުޝާދުތަކާ އެއްގޮތަށް އަމަލުކުރައްވާ.",

