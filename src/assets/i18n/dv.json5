  "item.edit.bitstreams.bundle.tooltip": "ބިޓްސްޓްރީމެއް އެހެން ސަފުހާއަކަށް ބަދަލުކުރުމަށްޓަކައި، ސަފުހާގެ ނަންބަރު މައްޗަށް އެ އެތި ދަމާލާ (Drop).",

